---
import Layout from '../components/Layout.astro';
import TypedHero from '../components/TypedHero.astro';
const projects = [
  { title: 'Project One', description: 'Short description of project one', url: '#' },
  { title: 'Project Two', description: 'Short description of project two', url: '#' }
];
const posts = [{ title: 'Welcome — Starter post', url: '#', date: '2025-12-29' }];
---
<Layout title="Sneh Patel — Portfolio" description="Portfolio of Sneh Patel">
  <section id="home" class="container py-24 reveal">
    <div class="max-w-2xl">
      <h1 class="text-5xl font-bold leading-tight mb-4">Hi, I’m Sneh Patel.</h1>
      <p class="text-xl text-slate-200 mb-6">
        <TypedHero strings={['I build web things.', 'I design web products.', 'I create experiences.']} />
      </p>
      <div class="flex gap-3">
        <a href="#projects" class="px-5 py-3 bg-accent text-slate-900 rounded-lg font-medium transition-transform transform hover:-translate-y-1">Projects</a>
        <a href="#contact" class="px-5 py-3 border border-slate-600 rounded-lg text-slate-200 hover:bg-slate-800">Contact</a>
      </div>
    </div>
  </section>

  <section id="projects" class="container py-20">
    <h2 class="text-2xl font-semibold mb-6 reveal">Projects</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map(p => (
        <article class="bg-card border rounded-lg p-6 reveal">
          <h3 class="font-semibold text-lg text-white">{p.title}</h3>
          <p class="text-slate-300 mt-2">{p.description}</p>
          <div class="mt-4">
            <a class="text-accent hover:underline" href={p.url}>View project →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="blog" class="container py-20">
    <h2 class="text-2xl font-semibold mb-6 reveal">Blog</h2>
    <ul class="space-y-4">
      {posts.map(p => (
        <li class="reveal">
          <a href={p.url} class="text-accent font-medium">{p.title}</a>
          <div class="text-sm text-slate-400">{p.date}</div>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="container py-20">
    <h2 class="text-2xl font-semibold mb-6 reveal">Contact</h2>
    <p class="text-slate-300 reveal">Want to work together? Email me at <strong>you@example.com</strong>.</p>
  </section>
</Layout>