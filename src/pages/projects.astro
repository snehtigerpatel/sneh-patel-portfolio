---
import Layout from '../components/Layout.astro';
const projects = [
  {
    id: 'project-one',
    title: 'Project One',
    description: 'A short description of project one, what it does and tech used.',
    link: '#'
  },
  {
    id: 'project-two',
    title: 'Project Two',
    description: 'Short description of project two.',
    link: '#'
  }
];
---
<Layout title="Projects — Sneh Patel">
  <section class="container py-16">
    <h2 class="text-2xl font-bold mb-6">Projects</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map(p => (
        <article id={p.id} class="border rounded p-6">
          <h3 class="font-semibold text-lg"><a class="text-accent" href={p.link}>{p.title}</a></h3>
          <p class="text-slate-700 mt-2">{p.description}</p>
          <div class="mt-4">
            <a class="text-sm hover:underline" href={p.link}>View project →</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>