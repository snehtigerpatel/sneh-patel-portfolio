---
/* Small client-only particles overlay using CDN ESM to avoid SSR import issues */
---
<div id="tsparticles" class="pointer-events-none fixed inset-0 z-0"></div>

<script is:inline>
  (async () => {
    if (typeof window === 'undefined') return;
    // load tsParticles via CDN ESM (keeps repo deps minimal)
    try {
      const { tsParticles } = await import('https://cdn.jsdelivr.net/npm/tsparticles-engine@^3.0.0/+esm');
      const { loadFull } = await import('https://cdn.jsdelivr.net/npm/tsparticles@^3.0.0/+esm');
      await loadFull(tsParticles);

      tsParticles.load('tsparticles', {
        fullScreen: { enable: false },
        particles: {
          number: { value: 28, density: { enable: true, area: 800 } },
          color: { value: '#06b6d4' },
          opacity: { value: 0.08 },
          size: { value: { min: 1, max: 3 } },
          links: { enable: true, distance: 130, color: '#06b6d4', opacity: 0.05 },
          move: { enable: true, speed: 0.5, outModes: 'out' }
        },
        detectRetina: true,
        fpsLimit: 60,
        background: {}
      });
    } catch (e) {
      // silent fail on older browsers or blocked CDN
      console.warn('tsparticles failed to load', e);
    }
  })();
</script>