---
import Layout from '../components/Layout.astro';
const projects = [
  { title: 'Project One', description: 'Short description of project one', url: '/projects#project-one' },
  { title: 'Project Two', description: 'Short description of project two', url: '/projects#project-two' }
];
const posts = [{ title: 'Welcome — Starter post', slug: '/blog/2025-12-29-welcome' }];
---
<Layout title="Snehtiger Patel — Portfolio" description="Portfolio of Snehtiger Patel">
  <section class="container py-16">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div id="hero" class="reveal">
        <h1 class="text-4xl font-bold mb-4">Hi, I’m Snehtiger Patel.</h1>
        <p class="text-lg text-slate-700 mb-6">I build web things — products, tooling, and portfolios. (Replace this with your short bio.)</p>
        <div class="flex gap-3">
          <a href="/projects" class="px-4 py-2 bg-accent text-white rounded transition transform hover:-translate-y-0.5">View projects</a>
          <a href="/contact" class="px-4 py-2 border rounded hover:bg-slate-50 transition">Contact</a>
        </div>
      </div>

      <div>
        <div class="bg-slate-50 border rounded p-6 reveal">
          <h3 class="font-semibold mb-2">Featured projects</h3>
          <ul class="space-y-3">
            {projects.map(p => (
              <li>
                <a class="text-accent font-medium" href={p.url}>{p.title}</a>
                <div class="text-sm text-slate-600">{p.description}</div>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 reveal">
          <h4 class="font-semibold">Latest post</h4>
          <a class="text-accent" href={posts[0].slug}>{posts[0].title}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;

    // Hero: add visible class on load for a smooth entrance
    window.addEventListener('load', () => {
      const hero = document.getElementById('hero');
      if (hero) requestAnimationFrame(() => hero.classList.add('reveal-visible'));
    });

    // IntersectionObserver for other .reveal elements
    const reveals = document.querySelectorAll('.reveal:not(#hero)');
    if (reveals.length === 0) return;

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      reveals.forEach(el => io.observe(el));
    } else {
      // Fallback: make them visible immediately
      reveals.forEach(el => el.classList.add('reveal-visible'));
    }
  })();
</script>