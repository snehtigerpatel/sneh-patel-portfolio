---
import Layout from '../components/Layout.astro';

const projects = [
  {
    title: 'Project One',
    description: 'Short description of project one',
    url: '/projects#project-one'
  },
  {
    title: 'Project Two',
    description: 'Short description of project two',
    url: '/projects#project-two'
  }
];

const posts = [
  { title: 'Welcome — Starter post', slug: '/blog/2025-12-29-welcome' }
];
---
<Layout title="Sneh Patel — Portfolio" description="Portfolio of Sneh Patel">
<!-- inside your page template -->
<section class="container py-16">
  <div id="hero" class="reveal">
    <h1 class="text-4xl font-bold mb-4">Hi, I’m Snehtiger Patel.</h1>
    <p class="text-lg text-slate-700 mb-6">I build web things — products, tooling, and portfolios.</p>
    <div class="flex gap-3">
      <a href="/projects" class="px-4 py-2 bg-accent text-white rounded transform transition hover:-translate-y-0.5">View projects</a>
      <a href="/contact" class="px-4 py-2 border rounded hover:bg-slate-50 transition">Contact</a>
    </div>
  </div>
</section>

<script>
  // run on load to add the visible class (keeps JS very small)
  window.addEventListener('load', () => {
    const el = document.getElementById('hero');
    if (el) requestAnimationFrame(() => el.classList.add('reveal-visible'));
  });
</script>

      <div>
        <div class="bg-slate-50 border rounded p-6">
          <h3 class="font-semibold mb-2">Featured projects</h3>
          <ul class="space-y-3">
            {projects.map(p => (
              <li>
                <a class="text-accent font-medium" href={p.url}>{p.title}</a>
                <div class="text-sm text-slate-600">{p.description}</div>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6">
          <h4 class="font-semibold">Latest post</h4>
          <a class="text-accent" href={posts[0].slug}>{posts[0].title}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>